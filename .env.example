APP_NAME="TL STORE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://tlstore.org
WEB_APP_URL=https://web.tlstore.org


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
#DB_CONNECTION=mysql
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=
#DB_USERNAME=
#DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Point at https://vtpass.com/api for live purchases. Keys are issued per
# environment, so the sandbox keys will never work against production.
VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_WEBHOOK_SECRET=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Select the default mailer with MAIL_MAILER=smtp|resend|mailgun|mailjet.
RESEND_API_KEY=
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USERNAME=resend
RESEND_SCHEME=smtps

MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USERNAME=
MAILGUN_SMTP_PASSWORD=
MAILGUN_SCHEME=smtp

MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_SCHEME=smtp
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

SUPPORT_EMAIL=support@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hosted top-up checkout providers (leave blank until configured in each provider dashboard).
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_BASE_URL=https://api.bachs.io/v1

# Fincra: api-key (secret) + public key from the portal; webhook secret signs
# HMAC-SHA512 over the raw body; business ID scopes the wallets/balances API.
FINCRA_SECRET_KEY=
FINCRA_PUBLIC_KEY=
FINCRA_BUSINESS_ID=
FINCRA_WEBHOOK_SECRET=
FINCRA_BASE_URL=https://api.fincra.com
FINCRA_FEE_BEARER=business

# App-link verification (/.well-known/assetlinks.json + apple-app-site-association).
# Leave blank until the signing certificates exist: the endpoints answer 404.
ANDROID_APP_PACKAGE=pynith.tlstore.review
ANDROID_SHA256_CERT_FINGERPRINTS=
# Full iOS universal-link app ID: TEAMID.bundle.id
IOS_APP_ID=

PAYMENT_RETURN_URL=https://tlstore.org/payments/return
# Set this to a public HTTPS API origin before enabling online providers.
PAYMENT_WEBHOOK_BASE_URL=https://tlstore.org


GOOGLE_CLIENT_ID=1068160277012-c3ch9j3accl0qngquv7s0mje6iv908jc.apps.googleusercontent.com

FACEBOOK_APP_ID=1425743543104162
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=tlstore_ai_bot

# Notification bot that posts announcements + withdrawal receipts to a group or
# channel. Leave the token blank to reuse TELEGRAM_BOT_TOKEN above; both can be
# overridden from the admin console, where they are stored encrypted.
TELEGRAM_NOTIFY_BOT_TOKEN=
# Numeric group/channel id (-1001234567890) or public channel username (@name).
TELEGRAM_NOTIFY_CHAT_ID=
# Attach the withdrawal receipt as an inline image (needs Ghostscript) instead
# of a PDF document. Leave enabled; the PDF is sent automatically as fallback.
TELEGRAM_RECEIPT_IMAGE=true
# Optional explicit path to the Ghostscript binary used to rasterise receipts.
TELEGRAM_GHOSTSCRIPT_BINARY=

FCM_ENABLED=true
FCM_PROJECT_ID=tl-store-application
FCM_SERVICE_ACCOUNT_PATH=storage/app/firebase/tl-store-application.json


# Password given to the demo admin/user accounts created by the demo
# seeders. Leave blank in every real environment: seeding demo accounts
# then refuses to run instead of creating a guessable password.
SYSTEM_ACCOUNT_PASSWORD=
