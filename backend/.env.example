APP_NAME=Nextel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Admin area URL prefix. Set to an unguessable value in production (obscures the backoffice).
BACKOFFICE_PATH=backoffice

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nextel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend transport — set MAIL_MAILER=resend to use it
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Mobile API (v1) ─────────────────────────────────────────────────────────
# Catch-all request budget for /api/* (requests per minute per client).
# Tighter per-route limiters (login/register/OTP/money endpoints) are defined
# in AppServiceProvider and do not use this value.
API_RATE_LIMIT=120
# Sanctum bearer-token lifetime in minutes (blank = tokens never expire).
SANCTUM_TOKEN_EXPIRATION=

# ── Telegram Mini App ──────────────────────────────────────────────────────
# Bot token from @BotFather (server-side only — never shipped to the client).
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where the Mini App is served (used by telegram:set-menu).
TELEGRAM_WEBAPP_URL=
# Max age (seconds) of Telegram initData.auth_date accepted at sign-in.
TELEGRAM_AUTH_MAX_AGE=3600
# Bot commands webhook (/webhooks/telegram). Set the webhook with:
# php artisan telegram:set-webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Access gate for the authenticated Livewire sections. Requests to gated
# pages without the app_gate cookie receive an empty 403; every non-gated
# page mints the cookie. Leave the secret empty to disable the gate.
APP_GATE_COOKIE=app_gate
APP_GATE_SECRET=
# Optional: cookie domain incl. subdomains, e.g. APP_GATE_DOMAIN=.easyportaltopupxyz.com
APP_GATE_DOMAIN=

VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=

BACKUP_ENABLED=false
BACKUP_KEEP_DAYS=14
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Drive folder NAME to store backups in — created automatically if missing (blank = My Drive root)
GOOGLE_DRIVE_FOLDER=

# Which payment manager the backoffice manages (korapay|paystack|flutterwave). Only the selected
# manager's wallet pages appear in the backoffice sidebar.
ACTIVE_PAYMENT_MANAGER=korapay

# Paystack (checkout charges + backoffice payouts)
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
# Backoffice payouts (Send money): currencies an admin may disburse in, and the per-payout ceiling.
PAYSTACK_PAYOUT_CURRENCIES=NGN
PAYSTACK_PAYOUT_MAX=1000000

# MevonPay (checkout charges for the five routed purchases). The secret key is server-side only.
MEVONPAY_BASE_URL=https://api.mevonpay.com.ng
MEVONPAY_SECRET_KEY=
MEVONPAY_PUBLIC_KEY=
MEVONPAY_CURRENCY=NGN
# MevonPay's API reference is not machine-readable; confirm these three against their docs/portal.
# Amounts: false = naira (major units), true = kobo (subunits). Wrong = 100x money error.
MEVONPAY_INITIALIZE_PATH=/api/v1/checkout/initialize
MEVONPAY_VERIFY_PATH=/api/v1/checkout/verify/{reference}
MEVONPAY_AMOUNT_IN_SUBUNITS=false
# Webhook signature: leave MEVONPAY_WEBHOOK_SIGNATURE_MODE blank to REFUSE all webhooks (fail
# closed). Set to 'hmac' (signed over the raw body) or 'hash' (shared secret compared verbatim).
MEVONPAY_WEBHOOK_SECRET=
MEVONPAY_WEBHOOK_SIGNATURE_MODE=
MEVONPAY_WEBHOOK_SIGNATURE_HEADER=x-mevonpay-signature
MEVONPAY_WEBHOOK_SIGNATURE_ALGO=sha512


# Bachs (bachs.io) — hosted checkout + backoffice payouts. Sandbox keys start sk_sandbox_ and go with
# BACHS_BASE_URL=https://sandbox-api.bachs.io; live keys start sk_live_.
BACHS_BASE_URL=https://api.bachs.io
BACHS_SECRET_KEY=
BACHS_PUBLIC_KEY=
BACHS_CURRENCY=NGN
# The webhook endpoint's signing secret (Developer portal → Webhooks). Blank refuses all webhooks.
BACHS_WEBHOOK_SECRET=
BACHS_WEBHOOK_TOLERANCE=300
BACHS_CHECKOUT_EXPIRY_MINUTES=60
# Optional corridor restriction, e.g. "USD_CARD,NGN_BANK_TRANSFER". Empty = all enabled methods.
BACHS_PAYMENT_METHOD_TYPES=
BACHS_LOOKUP_SCAN_PAGES=2
BACHS_PAYOUT_CURRENCIES=NGN
BACHS_PAYOUT_MAX=1000000
BACHS_DEFAULT_COUNTRY=NG


# Flutterwave (checkout charges + backoffice payouts)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_CURRENCY=NGN
# Backoffice payouts (Send money): wallets an admin may disburse from, and the per-payout ceiling.
FLUTTERWAVE_PAYOUT_CURRENCIES=NGN
FLUTTERWAVE_PAYOUT_MAX=1000000

# Korapay (bills wallet top-up via checkout redirect)
KORAPAY_BASE_URL=https://api.korapay.com
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_CURRENCY=NGN
# Backoffice payouts (Send money): currencies an admin may disburse in, and the per-payout ceiling.
KORAPAY_PAYOUT_CURRENCIES=NGN
KORAPAY_PAYOUT_MAX=1000000
# Optional: which gateway collects direct card purchases (default korapay). The Revenue
# Authentication page sells special storage codes directly, too.
STORAGE_PAYMENT_PROVIDER=korapay
PACKAGE_PAYMENT_PROVIDER=korapay
SPECIAL_COUPON_PAYMENT_PROVIDER=korapay

# Revenue-code / payout support desk shown on the Revenue Authentication page. Admins can change
# it in backoffice → Settings → General; this is only the fallback for a fresh install.
REVENUE_SUPPORT_TELEGRAM=https://t.me/nextelSpecialSupport

# Default password for seeded system accounts (super admin + system vendors)
SYSTEM_ACCOUNT_PASSWORD=
